# Application
APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
MODEL_API_URL=
NEXT_PUBLIC_API_URL=

# Persistent database (production: PostgreSQL)
DATABASE_URL=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=1800

# Security
AUTH_SECRET=
NEXTAUTH_SECRET=
ADMIN_API_TOKEN=
ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:3000
ALLOW_RUNTIME_TRAINING=false

# Google Identity Services
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Gemini — server-side only
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# data.gov.in — configure only verified official resource IDs
DATAGOVIN_API_KEY=
DATAGOVIN_RESOURCE_LAND_ACQUISITION=
DATAGOVIN_RESOURCE_INFRASTRUCTURE=

# Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY=

# Demo flags are disabled by default. Do not enable in production.
DEMO_MODE=false
NEXT_PUBLIC_DEMO_MODE=false
