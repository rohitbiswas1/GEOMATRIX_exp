# GEOMATRIX environment template
APP_ENV=development

# Next.js -> FastAPI service
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=
MODEL_API_URL=

# FastAPI security / service boundaries
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000
ALLOWED_HOSTS=localhost,127.0.0.1
INTERNAL_API_TOKEN=
ADMIN_API_TOKEN=

# Database
DATABASE_URL=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=1800
ALLOW_PRODUCTION_SQLITE=false

# Google Identity Services
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/google/callback
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=true
AUTH_SECRET=
NEXTAUTH_SECRET=

# Gemini (server-side only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY=

# Official open-data ingestion
DATAGOVIN_API_KEY=

# Model operations
ALLOW_RUNTIME_TRAINING=false

# Prototype/demo modes must remain disabled in a production handover
DEMO_MODE=false
NEXT_PUBLIC_DEMO_MODE=false
