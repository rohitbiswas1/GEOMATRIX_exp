{
  "services": {
    "frontend": {
      "root": "./",
      "framework": "nextjs"
    },
    "backend": {
      "root": "geomatrix_v2/",
      "entrypoint": "main:app"
    }
  },
  "rewrites": [
    {
      "source": "/backend/:path*",
      "destination": { "service": "backend" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "frontend" }
    }
  ]
}
